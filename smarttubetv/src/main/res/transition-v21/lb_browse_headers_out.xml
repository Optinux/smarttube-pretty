<?xml version="1.0" encoding="utf-8"?>
<transitionSet
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/lb_browse_headers_transition_duration">
    <changeBounds
        android:interpolator="@interpolator/m3_standard" />
    <changeTransform
        android:interpolator="@interpolator/m3_standard">
        <targets>
            <target android:targetId="@id/container_list" />
        </targets>
    </changeTransform>
    <fade
        android:transitionVisibilityMode="mode_in"
        android:interpolator="@interpolator/m3_emphasized_decelerate" />
    <fade
        android:transitionVisibilityMode="mode_out"
        android:interpolator="@interpolator/m3_accelerate" />
</transitionSet>
