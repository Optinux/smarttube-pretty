<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_spotlight_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/lb_browse_padding_start"
    android:paddingEnd="@dimen/lb_browse_padding_end"
    android:paddingTop="4dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/hero_spotlight_card"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="afterDescendants">

        <!-- Right-aligned high-res artwork with smooth directional scrim -->
        <ImageView
            android:id="@+id/hero_artwork"
            android:layout_width="460dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:alpha="0.92"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <View
            android:id="@+id/hero_scrim_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/hero_scrim_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Left editorial content & M3 Expressive action stage -->
        <LinearLayout
            android:id="@+id/hero_content_column"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    tools:targetApi="21" />

                <TextView
                    android:id="@+id/hero_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textSize="12sp"
                    tools:targetApi="21" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="420dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="2"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="420dp"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textSize="13sp" />

            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.styled.CardProgressBar
                android:id="@+id/hero_progress"
                android:layout_width="180dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hero_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.m3e.M3Button
                    android:id="@+id/hero_btn_watch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:nextFocusRight="@id/hero_btn_options" />

                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.m3e.M3Button
                    android:id="@+id/hero_btn_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:nextFocusLeft="@id/hero_btn_watch"
                    android:nextFocusRight="@id/hero_btn_next" />

                <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.m3e.M3Button
                    android:id="@+id/hero_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:nextFocusLeft="@id/hero_btn_options" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top-right pager indicator pills (avoids colliding with action buttons) -->
        <LinearLayout
            android:id="@+id/hero_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>
</FrameLayout>
