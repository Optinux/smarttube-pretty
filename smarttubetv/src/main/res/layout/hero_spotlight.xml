<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_spotlight_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="?attr/browsePaddingStart"
    android:paddingEnd="?attr/browsePaddingStart"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- Leanback RowsSupportFragment aligns row_content to ?attr/browseRowsMarginTop (126dp).
         HeroSpotlightPresenter measures the top bar's lowest visible element + insets + ?attr/browsePaddingTop
         and sizes hero_spotlight_card + row_content/card topMargin dynamically so its bottom edge
         and all shelves below stay at the exact same y-position. -->
    <View
        android:id="@id/row_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="0dp" />

    <FrameLayout
        android:id="@+id/hero_spotlight_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_spotlight_baseline_height"
        android:clickable="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAccessibility="yes">

        <!-- Right-aligned 16:9 center-cropped media stage: thumbnail underneath, TextureView player above -->
        <FrameLayout
            android:id="@+id/hero_media_container"
            android:layout_width="555dp"
            android:layout_height="match_parent"
            android:layout_gravity="end">

            <ImageView
                android:id="@+id/hero_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <!--
                Uses surface_type="texture_view" so the preview video can be alpha-crossfaded,
                gradient-scrimmed, and clipped to rounded corners smoothly.
                Tradeoff vs SurfaceView: slightly higher GPU/memory composition cost and no DRM support.
            -->
            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/hero_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:focusable="false"
                app:resize_mode="zoom"
                app:show_buffering="never"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:use_controller="false" />
        </FrameLayout>

        <!-- Eased multi-stop horizontal gradient dissolving the video into the derived banner tone -->
        <View
            android:id="@+id/hero_scrim_horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/hero_scrim_top"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="top" />

        <View
            android:id="@+id/hero_scrim_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Bottom-left plain text metadata over scrim (no icons or action buttons) -->
        <LinearLayout
            android:id="@+id/hero_content_column"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|start"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.08"
                android:maxLines="2"
                android:maxWidth="460dp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/hero_channel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="460dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hero_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:maxWidth="460dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Top-right pager indicator pills -->
        <LinearLayout
            android:id="@+id/hero_dots_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </FrameLayout>
</FrameLayout>
