<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              xmlns:tools="http://schemas.android.com/tools"
              android:id="@+id/main_frame"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="?attr/m3SurfaceContainer"
              android:elevation="@dimen/lb_preference_decor_elevation"
              android:orientation="vertical"
              android:transitionGroup="false"
              tools:targetApi="21">

    <FrameLayout
        android:id="@+id/decor_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/m3SurfaceContainerHigh"
        android:elevation="0dp"
        android:transitionGroup="false">

        <!-- Change TextView to TitleMarqueeTextViewCompat if you need scrolled header in dialogs -->
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.TitleMarqueeTextViewCompat
            android:id="@+id/decor_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/lb_preference_decor_title_text_height"
            android:layout_marginTop="@dimen/lb_preference_decor_title_margin_top"
            android:layout_marginStart="@dimen/lb_preference_decor_title_margin_start"
            android:layout_marginEnd="@dimen/lb_preference_decor_title_margin_end"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:textSize="20sp"
            android:textColor="?attr/m3OnSurface"
            android:singleLine="false"
            android:maxLines="2"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="?attr/m3OutlineVariant" />
    </FrameLayout>

    <!--<TextView-->
    <!--    android:id="@android:id/message"-->
    <!--    android:layout_width="match_parent"-->
    <!--    android:layout_height="wrap_content"-->
    <!--    android:fontFamily="sans-serif-condensed"-->
    <!--    android:paddingTop="14dp"-->
    <!--    android:paddingBottom="14dp"-->
    <!--    android:paddingStart="24dp"-->
    <!--    android:paddingEnd="56dp"-->
    <!--    android:visibility="gone" />-->

    <com.stfalcon.chatkit.messages.MessagesList
        android:id="@+id/messagesList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        app:textAutoLink="web"
        app:showIncomingTime="false"
        app:isMessageFocusable="true"
        app:incomingBubblePaddingLeft="14dp"
        app:incomingBubblePaddingRight="14dp"
        app:incomingBubblePaddingTop="8dp"
        app:incomingBubblePaddingBottom="8dp"
        app:incomingAvatarWidth="32dp"
        app:incomingAvatarHeight="32dp"
        app:incomingDefaultBubbleColor="?attr/m3SurfaceContainerHigh"
        app:incomingDefaultBubbleSelectedColor="?attr/m3SecondaryContainer"
        app:incomingDefaultBubblePressedColor="?attr/m3SecondaryContainer"
        app:incomingTextColor="?attr/m3OnSurface" />

</LinearLayout>
