<?xml version="1.0" encoding="utf-8"?>
<androidx.leanback.widget.NonOverlappingLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/m3_header_pill_padding_horizontal"
    android:paddingEnd="@dimen/m3_header_pill_padding_horizontal"
    android:paddingTop="@dimen/m3_header_pill_padding_vertical"
    android:paddingBottom="@dimen/m3_header_pill_padding_vertical">

    <ImageView
        android:id="@+id/header_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/header_icon" />

    <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.marqueetextviewcompat.HeaderMarqueeTextViewCompat
        android:id="@+id/header_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"

        android:fontFamily="sans-serif-medium"
        android:textSize="15sp"
        android:textColor="?attr/m3OnSurface"
        android:singleLine="true"
        android:maxWidth="160dp"
        android:marqueeRepeatLimit="marquee_forever"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"

        style="@style/TextAppearance.Leanback.Header"/>
</androidx.leanback.widget.NonOverlappingLinearLayout>
