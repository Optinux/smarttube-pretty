<?xml version="1.0" encoding="utf-8"?>
<com.liskovsoft.smartyoutubetv2.tv.ui.browse.settings.SettingsHubRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="112dp"
    android:paddingBottom="22dp"
    android:descendantFocusability="afterDescendants">

    <!-- Left Pane: M3 Expressive Categorized Navigation Rail -->
    <LinearLayout
        android:id="@+id/settings_rail_pane"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/settings_rail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/settings_hub_title"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/settings_rail_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxWidth="112dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_rail_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- M3 Expanded Breakpoint Spacer -->
    <Space
        android:id="@+id/settings_pane_spacer"
        android:layout_width="18dp"
        android:layout_height="match_parent" />

    <!-- Right Pane: Interactive Detail & Live Controls Canvas -->
    <ScrollView
        android:id="@+id/settings_detail_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="start"
        android:focusable="false"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_detail_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:orientation="vertical"
            android:padding="20dp"
            tools:ignore="UselessParent" />
    </ScrollView>
</com.liskovsoft.smartyoutubetv2.tv.ui.browse.settings.SettingsHubRootLayout>
