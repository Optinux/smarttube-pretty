<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/lb_browse_padding_start"
    android:paddingEnd="36dp"
    android:paddingTop="96dp"
    android:paddingBottom="22dp"
    android:descendantFocusability="afterDescendants">

    <!-- Left Pane: M3 Expressive Categorized Navigation Rail -->
    <LinearLayout
        android:id="@+id/settings_rail_pane"
        android:layout_width="296dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/settings_rail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/settings_hub_title"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/settings_rail_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxWidth="130dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp" />
        </LinearLayout>

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/settings_rail_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:verticalSpacing="4dp" />
    </LinearLayout>

    <!-- M3 Expanded Breakpoint Spacer (20dp) -->
    <Space
        android:layout_width="20dp"
        android:layout_height="match_parent" />

    <!-- Right Pane: Interactive Detail & Live Controls Canvas -->
    <ScrollView
        android:id="@+id/settings_detail_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_detail_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="24dp"
            tools:ignore="UselessParent" />
    </ScrollView>
</LinearLayout>
