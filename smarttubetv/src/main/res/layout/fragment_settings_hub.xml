<?xml version="1.0" encoding="utf-8"?>
<com.liskovsoft.smartyoutubetv2.tv.ui.browse.settings.SettingsHubRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="24dp"
    android:paddingBottom="22dp"
    android:descendantFocusability="afterDescendants">

    <!-- Left Pane: M3 Expressive Categorized Navigation Rail -->
    <LinearLayout
        android:id="@+id/settings_rail_pane"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <LinearLayout
            android:id="@+id/settings_rail_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp">

            <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.m3e.M3Button
                android:id="@+id/settings_back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/abc_action_bar_up_description" />

            <TextView
                android:id="@+id/settings_rail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/settings_hub_title"
                android:textSize="19sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_rail_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- M3 Expanded Breakpoint Spacer -->
    <Space
        android:id="@+id/settings_pane_spacer"
        android:layout_width="18dp"
        android:layout_height="match_parent" />

    <!-- Right Pane: Interactive Detail & Live Controls Canvas -->
    <FrameLayout
        android:id="@+id/settings_detail_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="start"
        android:padding="16dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <ScrollView
            android:id="@+id/settings_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_detail_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:orientation="vertical"
                android:padding="4dp"
                tools:ignore="UselessParent" />
        </ScrollView>
    </FrameLayout>
</com.liskovsoft.smartyoutubetv2.tv.ui.browse.settings.SettingsHubRootLayout>
